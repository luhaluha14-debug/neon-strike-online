{
  "name": "tactical-fps",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based 5v5 round-based tactical FPS (prototype: movement foundation)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json && vite build --config vite.server.config.ts",
    "start": "node dist-server/main.js",
    "build:mp": "tsc -p tsconfig.server.json && vite build --config vite.mp.config.ts",
    "start:mp": "node dist-mp/main.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "node tests/run.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "pg": "8.23.1",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "playwright": "1.56.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
